# Copia este archivo a ".env" (para Prisma / el servidor local) y llena
# los valores reales de tu proyecto de Supabase. ".env" nunca se sube a
# git (ver .gitignore).

# --- Para el navegador (Vite las expone con el prefijo VITE_) ---
# Project URL: Supabase Dashboard -> Settings -> API -> "Project URL"
VITE_SUPABASE_URL=https://xxxxxxxxxxxxx.supabase.co
# anon public key: Settings -> API -> "anon public" (segura de compartir,
# protegida por las reglas de RLS, no por ser secreta)
VITE_SUPABASE_ANON_KEY=

# --- Solo para Prisma (migraciones y el motor de sincronización de la
# app de escritorio) — NUNCA se usan en el navegador ---
# Settings -> Database -> Connection string -> "Transaction" pooler (puerto 6543)
DATABASE_URL=postgresql://postgres.xxxxxxxxxxxxx:PASSWORD@aws-0-region.pooler.supabase.com:6543/postgres?pgbouncer=true
# Settings -> Database -> Connection string -> conexión directa (puerto 5432),
# la usan solo las migraciones (prisma migrate)
DIRECT_URL=postgresql://postgres.xxxxxxxxxxxxx:PASSWORD@aws-0-region.pooler.supabase.com:5432/postgres
